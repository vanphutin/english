{
  "name": "english-grammar-learning",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "overrides": {
      "js-yaml@>=5.0.0 <5.2.2": "5.2.2"
    }
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @english/api --filter @english/web --filter @english/worker dev",
    "dev:api": "pnpm --filter @english/api dev",
    "dev:web": "pnpm --filter @english/web dev",
    "dev:worker": "pnpm --filter @english/worker dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm exec tsc --noEmit && pnpm -r --if-present typecheck",
    "contracts:validate": "tsx scripts/validate-contracts.ts && redocly lint openapi/openapi.yaml",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "grammar:import": "tsx scripts/grammar-kb.ts import",
    "grammar:publish": "tsx scripts/grammar-kb.ts publish",
    "curriculum:import": "tsx scripts/curriculum.ts import",
    "curriculum:publish": "tsx scripts/curriculum.ts publish",
    "exercise:seed": "tsx scripts/seed-exercises.ts",
    "exercise:generate-bank": "tsx scripts/generate-exercise-bank.ts",
    "exercise:seed-activities": "tsx scripts/seed-activity-variants.ts",
    "exercise:seed-corrections": "tsx scripts/seed-correction-activities.ts",
    "exercise:author-transforms": "tsx scripts/author-transform-activities.ts",
    "exercise:validate-transforms": "tsx scripts/validate-transform-activities.ts",
    "exercise:curate-transforms": "tsx scripts/curate-transform-publication.ts",
    "content:author:foundation": "tsx scripts/author-foundation-content.ts",
    "content:publish:foundation": "tsx scripts/publish-foundation-content.ts",
    "content:author:intermediate": "tsx scripts/author-intermediate-content.ts",
    "content:publish:intermediate": "tsx scripts/publish-intermediate-content.ts",
    "content:author:advanced": "tsx scripts/author-advanced-content.ts",
    "content:publish:advanced": "tsx scripts/publish-advanced-content.ts",
    "content:author:autonomous": "tsx --env-file=.env scripts/author-autonomous-content.ts",
    "evaluator:golden": "tsx scripts/evaluator-golden.ts",
    "evaluator:golden:live": "tsx scripts/evaluator-golden.ts --live",
    "engagement:rebuild-errors": "pnpm --filter @english/engagement build && tsx scripts/rebuild-error-patterns.ts",
    "story:seed:a1": "tsx scripts/seed-story-a1.ts",
    "ai:probe:secondary": "pnpm --filter @english/operations build && tsx --env-file=.env scripts/probe-ai-provider.ts",
    "owner:create": "tsx scripts/create-owner.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "test:e2e": "playwright test",
    "start:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "diagnostics": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/diagnostics-local.ps1",
    "backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-local.ps1",
    "restore": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restore-local.ps1"
  },
  "devDependencies": {
    "@english/contracts": "workspace:*",
    "@english/curriculum": "workspace:*",
    "@english/evaluation": "workspace:*",
    "@english/engagement": "workspace:*",
    "@english/grammar-kb": "workspace:*",
    "@english/identity": "workspace:*",
    "@english/learning": "workspace:*",
    "@english/operations": "workspace:*",
    "@english/practice": "workspace:*",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@redocly/cli": "^1.34.5",
    "@types/node": "^20.19.25",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "prisma": "^6.19.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
