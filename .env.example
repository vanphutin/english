NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://english:english@localhost:6543/english?schema=public
SESSION_SECRET=replace-with-at-least-32-random-characters

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_AUTHORING_MODEL=gpt-5-mini
# Required for Content Factory CF4. When authoring uses OPENAI, this must differ from OPENAI_AUTHORING_MODEL.
OPENAI_REVIEW_MODEL=
# Optional; defaults to OPENAI_REVIEW_MODEL. It must remain independent from the author provider/model.
OPENAI_PREFLIGHT_MODEL=
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_TRANSIENT_RETRIES=2

SECONDARY_AI_BASE_URL=https://api.17.wtf/v1
SECONDARY_AI_ALLOWED_HOST=api.17.wtf
SECONDARY_AI_API_KEY=
SECONDARY_AI_MODEL=
SECONDARY_AI_ENABLED=false
SECONDARY_AI_TIMEOUT_MS=30000
SECONDARY_AI_MAX_TRANSIENT_RETRIES=2

# Content Factory CF4 runtime. Secondary authoring additionally requires a live VERIFIED capability probe.
CONTENT_FACTORY_AUTHOR_PROVIDER=OPENAI
CONTENT_FACTORY_SECONDARY_GOLDEN_APPROVED=false
CONTENT_FACTORY_GRAMMAR_OUTPUT_TOKENS=3500
CONTENT_FACTORY_REVIEW_OUTPUT_TOKENS=2200
CONTENT_FACTORY_PREFLIGHT_OUTPUT_TOKENS=5000
CONTENT_FACTORY_EXERCISE_OUTPUT_TOKENS_PER_ITEM=350
CONTENT_FACTORY_REVIEW_INPUT_TOKEN_RESERVE=4500
CONTENT_FACTORY_EXERCISE_INPUT_TOKEN_RESERVE=5000
# Estimated-cost values are reservation inputs, not provider billing reconciliation.
CONTENT_FACTORY_GRAMMAR_ESTIMATED_COST=0
CONTENT_FACTORY_REVIEW_ESTIMATED_COST=0
CONTENT_FACTORY_PREFLIGHT_ESTIMATED_COST=0
CONTENT_FACTORY_EXERCISE_ESTIMATED_COST=0

WORKER_ID=local-worker-1
WORKER_POLL_MS=1000
WORKER_MAX_ATTEMPTS=4
WORKER_LEASE_SECONDS=90
