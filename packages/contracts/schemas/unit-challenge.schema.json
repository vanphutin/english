{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english.local/schemas/unit-challenge.schema.json",
  "title": "Unit Challenge Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "unitId",
    "unitTitle",
    "sessionId",
    "status",
    "policyVersion",
    "startedAt",
    "completedAt",
    "targets",
    "remediationGrammarPointIds"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "unitId": { "type": "string", "format": "uuid" },
    "unitTitle": { "type": "string" },
    "sessionId": { "type": "string", "format": "uuid" },
    "status": { "enum": ["ACTIVE", "COMPLETED"] },
    "policyVersion": { "const": "unit-challenge-v1" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "grammarPointId",
          "grammarCode",
          "grammarTitle",
          "outcome",
          "disposition",
          "attemptId",
          "reasonCodes"
        ],
        "properties": {
          "grammarPointId": { "type": "string", "format": "uuid" },
          "grammarCode": { "type": "string" },
          "grammarTitle": { "type": "string" },
          "outcome": { "enum": ["PASSED", "NEEDS_PRACTICE", "NO_EVIDENCE"] },
          "disposition": { "type": ["string", "null"] },
          "attemptId": { "type": ["string", "null"], "format": "uuid" },
          "reasonCodes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "remediationGrammarPointIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    }
  }
}
