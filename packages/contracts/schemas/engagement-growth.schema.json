{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grammar-path.local/schemas/engagement-growth.schema.json",
  "title": "Engagement growth views",
  "type": "object",
  "additionalProperties": false,
  "required": ["interests", "achievements", "weeklyReflection"],
  "properties": {
    "interests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvedTopics", "selectedTopics"],
      "properties": {
        "approvedTopics": {
          "type": "array",
          "items": { "$ref": "#/$defs/topic" },
          "uniqueItems": true
        },
        "selectedTopics": {
          "type": "array",
          "items": { "$ref": "#/$defs/topic" },
          "uniqueItems": true,
          "maxItems": 5
        }
      }
    },
    "achievements": { "type": "array", "items": { "$ref": "#/$defs/achievement" } },
    "weeklyReflection": { "$ref": "#/$defs/reflection" }
  },
  "$defs": {
    "topic": {
      "type": "string",
      "enum": [
        "DAILY_LIFE",
        "FAMILY",
        "STUDY",
        "WORK",
        "TECHNOLOGY",
        "TRAVEL",
        "SHOPPING",
        "HEALTH",
        "FOOD",
        "ENTERTAINMENT",
        "COMMUNITY",
        "NATURE",
        "BUSINESS"
      ]
    },
    "achievement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "titleVi", "descriptionVi", "granted", "grantedAt", "evidence"],
      "properties": {
        "code": { "type": "string" },
        "titleVi": { "type": "string" },
        "descriptionVi": { "type": "string" },
        "granted": { "type": "boolean" },
        "grantedAt": { "type": ["string", "null"], "format": "date-time" },
        "evidence": { "type": ["object", "null"] }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "textVi", "sourceRefs"],
      "properties": {
        "code": { "type": "string" },
        "textVi": { "type": "string", "minLength": 1 },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "focus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reasonCode", "textVi", "sourceRefs"],
      "properties": {
        "reasonCode": { "type": "string" },
        "textVi": { "type": "string", "minLength": 1 },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "reflection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyVersion", "weekStart", "weekEnd", "claims", "nextFocus"],
      "properties": {
        "policyVersion": { "const": "engagement-growth-v1" },
        "weekStart": { "type": "string", "format": "date" },
        "weekEnd": { "type": "string", "format": "date" },
        "claims": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/claim" } },
        "nextFocus": { "$ref": "#/$defs/focus" }
      }
    }
  }
}
