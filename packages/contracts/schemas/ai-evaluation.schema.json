{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english.local/schemas/ai-evaluation.schema.json",
  "title": "AiEvaluationOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "dispositionRecommendation",
    "dimensions",
    "findings",
    "feedbackVi",
    "acceptedAlternative",
    "uncertaintyReasons"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "dispositionRecommendation": {
      "enum": ["ACCEPT", "ACCEPT_WITH_FEEDBACK", "RETRY", "SYSTEM_REVIEW"]
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meaningPreservation",
        "targetGrammar",
        "otherGrammar",
        "vocabulary",
        "mechanics",
        "naturalness"
      ],
      "properties": {
        "meaningPreservation": { "$ref": "#/$defs/dimension" },
        "targetGrammar": { "$ref": "#/$defs/dimension" },
        "otherGrammar": { "$ref": "#/$defs/dimension" },
        "vocabulary": { "$ref": "#/$defs/dimension" },
        "mechanics": { "$ref": "#/$defs/dimension" },
        "naturalness": { "$ref": "#/$defs/dimension" }
      }
    },
    "findings": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/finding" } },
    "correctedAnswer": { "type": "string", "maxLength": 2000 },
    "feedbackVi": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "acceptedAlternative": { "type": "boolean" },
    "uncertaintyReasons": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 200 }
    }
  },
  "$defs": {
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "confidence"],
      "properties": {
        "status": { "enum": ["PASS", "MINOR_ISSUES", "FAIL", "UNCERTAIN"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "code", "severity", "messageVi"],
      "properties": {
        "category": {
          "enum": [
            "TARGET_GRAMMAR",
            "OTHER_GRAMMAR",
            "MEANING",
            "VOCABULARY",
            "SPELLING",
            "PUNCTUATION",
            "STYLE"
          ]
        },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "severity": { "enum": ["INFO", "MINOR", "MAJOR", "BLOCKING"] },
        "evidenceText": { "type": "string", "maxLength": 500 },
        "messageVi": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "suggestedFix": { "type": "string", "maxLength": 1000 }
      }
    }
  }
}
