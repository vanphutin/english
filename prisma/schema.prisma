model Evaluation {
  id                  String              @id @default(uuid()) @db.Uuid
  attemptId           String              @map("attempt_id") @db.Uuid
  evaluatorVersion    String              @map("evaluator_version")
  rubricVersion       String              @map("rubric_version")
  disposition         Disposition
  targetUsed          Boolean             @map("target_used")
  meaningPreserved    Boolean             @map("meaning_preserved")
  overallScore        Decimal             @map("overall_score") @db.Decimal(5, 2)
  confidence          Decimal             @db.Decimal(4, 3)
  feedbackVi          String              @map("feedback_vi")
  correctedAnswer     String?             @map("corrected_answer")
  dimensionsJson      Json                @map("dimensions_json")
  acceptedAlternative Boolean             @default(false) @map("accepted_alternative")
  uncertaintyReasons  String[]            @default([]) @map("uncertainty_reasons")
  isEffective         Boolean             @default(false) @map("is_effective")
  supersedesId        String?             @map("supersedes_id") @db.Uuid
  completedAt         DateTime            @default(now()) @map("completed_at") @db.Timestamptz
  attempt             Attempt             @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  supersedes          Evaluation?         @relation("EvaluationSupersession", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy        Evaluation[]        @relation("EvaluationSupersession")
  masteryEvents       MasteryEvent[]
  evaluationFindings  EvaluationFinding[]
  aiCalls             AiCall[]

  @@index([attemptId, isEffective])
  @@map("evaluations")
}

model MasteryEvent {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
