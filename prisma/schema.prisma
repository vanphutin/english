generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  RETIRED
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum RelationshipType {
  PREREQUISITE
  CONTRASTS_WITH
  BUILDS_ON
  OFTEN_CONFUSED_WITH
  PART_OF
}

enum AttemptStatus {
  SUBMITTED
  EVALUATING
  EVALUATED
  NEEDS_REVIEW
  FAILED
}

enum Disposition {
  ACCEPT
  ACCEPT_WITH_FEEDBACK
  RETRY
  SYSTEM_REVIEW
}

enum MasteryBand {
  UNSEEN
  LEARNING
  PRACTICING
  MASTERED
  REVIEW_DUE
  AT_RISK
}

model User {
  id                     String                      @id @default(uuid()) @db.Uuid
  username               String                      @unique
  passwordHash           String                      @map("password_hash")
  status                 String                      @default("ACTIVE")
  createdAt              DateTime                    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime                    @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt              DateTime?                   @map("deleted_at") @db.Timestamptz
  profile                UserProfile?
  sessions               LearningSession[]
  attempts               Attempt[]
  mastery                UserGrammarMastery[]
  masteryEvents          MasteryEvent[]
  hintEvents             HintEvent[]
  enrollments            UserCurriculumEnrollment[]
  levelProgress          LevelProgress[]
  authSessions           AuthSession[]
  errorPatterns          LearnerErrorPattern[]
  unitChallenges         UnitChallenge[]
  storyProgress          UserStoryProgress[]
  interestPreferences    LearnerInterestPreference[]
  achievementGrants      AchievementGrant[]
  weeklyProgressReports  WeeklyProgressReport[]
  meaningfulLearningDays MeaningfulLearningDay[]
  dailySurpriseViews     UserDailySurprise[]

  @@map("users")
}

model MeaningfulLearningDay {
  userId        String   @map("user_id") @db.Uuid
  learningDate  DateTime @map("learning_date") @db.Date
  dayType       String   @map("day_type")
  evidenceCount Int      @default(0) @map("evidence_count")
  evidenceRefs  String[] @default([]) @map("evidence_refs")
  policyVersion String   @map("policy_version")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, learningDate])
  @@index([userId, learningDate(sort: Desc)])
  @@map("meaningful_learning_days")
}

model DailySurprise {
  id            String              @id @default(uuid()) @db.Uuid
  contentKey    String              @unique @map("content_key")
  cefrLevel     CefrLevel           @map("cefr_level")
  type          String
  titleVi       String              @map("title_vi")
  bodyVi        String              @map("body_vi")
  topicCode     String              @map("topic_code")
  policyVersion String              @map("policy_version")
  status        ContentStatus       @default(DRAFT)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz
  userViews     UserDailySurprise[]

  @@index([status, cefrLevel])
  @@map("daily_surprises")
}

model UserDailySurprise {
  userId       String        @map("user_id") @db.Uuid
  surpriseDate DateTime      @map("surprise_date") @db.Date
  surpriseId   String        @map("surprise_id") @db.Uuid
  revealedAt   DateTime      @default(now()) @map("revealed_at") @db.Timestamptz
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  surprise     DailySurprise @relation(fields: [surpriseId], references: [id], onDelete: Restrict)

  @@id([userId, surpriseDate])
  @@index([surpriseId])
  @@map("user_daily_surprises")
}

model LearnerInterestPreference {
  userId    String   @map("user_id") @db.Uuid
  topicCode String   @map("topic_code")
  priority  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, topicCode])
  @@unique([userId, priority])
  @@map("learner_interest_preferences")
}

model AchievementDefinition {
  id            String             @id @default(uuid()) @db.Uuid
  code          String             @unique
  titleVi       String             @map("title_vi")
  descriptionVi String             @map("description_vi")
  ruleType      String             @map("rule_type")
  threshold     Int                @default(1)
  policyVersion String             @map("policy_version")
  status        String             @default("ACTIVE")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz
  grants        AchievementGrant[]

  @@map("achievement_definitions")
}

model AchievementGrant {
  id                      String                @id @default(uuid()) @db.Uuid
  userId                  String                @map("user_id") @db.Uuid
  achievementDefinitionId String                @map("achievement_definition_id") @db.Uuid
  evidenceKey             String                @map("evidence_key")
  evidenceSnapshotJson    Json                  @map("evidence_snapshot_json")
  policyVersion           String                @map("policy_version")
  grantedAt               DateTime              @default(now()) @map("granted_at") @db.Timestamptz
  user                    User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  definition              AchievementDefinition @relation(fields: [achievementDefinitionId], references: [id], onDelete: Restrict)

  @@unique([userId, achievementDefinitionId])
  @@index([achievementDefinitionId])
  @@index([userId, grantedAt(sort: Desc)])
  @@map("achievement_grants")
}

model WeeklyProgressReport {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  weekStart      DateTime @map("week_start") @db.Date
  weekEnd        DateTime @map("week_end") @db.Date
  policyVersion  String   @map("policy_version")
  factsJson      Json     @map("facts_json")
  presentationVi String   @map("presentation_vi")
  generatedAt    DateTime @default(now()) @map("generated_at") @db.Timestamptz
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, weekStart])
  @@index([userId, generatedAt(sort: Desc)])
  @@map("weekly_progress_reports")
}

model AuthSession {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

model UserProfile {
  userId          String @id @map("user_id") @db.Uuid
  displayName     String @map("display_name")
  nativeLocale    String @default("vi") @map("native_locale")
  targetLocale    String @default("en") @map("target_locale")
  timezone        String @default("Asia/Saigon")
  preferencesJson Json   @default("{}") @map("preferences_json")
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model GrammarPoint {
  id                   String                @id @default(uuid()) @db.Uuid
  code                 String                @unique
  familyCode           String                @map("family_code")
  canonicalSlug        String                @unique @map("canonical_slug")
  status               ContentStatus         @default(DRAFT)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz
  versions             GrammarPointVersion[]
  sourceRelations      GrammarRelationship[] @relation("SourcePoint")
  targetRelations      GrammarRelationship[] @relation("TargetPoint")
  mastery              UserGrammarMastery[]
  masteryEvents        MasteryEvent[]
  findings             EvaluationFinding[]
  learnerErrorPatterns LearnerErrorPattern[]
  unitChallengeTargets UnitChallengeTarget[]

  @@index([familyCode])
  @@map("grammar_points")
}

model GrammarPointVersion {
  id                   String           @id @default(uuid()) @db.Uuid
  grammarPointId       String           @map("grammar_point_id") @db.Uuid
  versionNo            Int              @map("version_no")
  cefrLevel            CefrLevel        @map("cefr_level")
  title                String
  shortDescription     String           @map("short_description")
  formSummary          String           @map("form_summary")
  meaningSummary       String           @map("meaning_summary")
  usageNotes           String?          @map("usage_notes")
  locale               String           @default("vi")
  status               ContentStatus    @default(DRAFT)
  publishedAt          DateTime?        @map("published_at") @db.Timestamptz
  contentHash          String           @map("content_hash")
  learningObjectiveEn  String           @map("learning_objective_en")
  provenanceJson       Json             @map("provenance_json")
  generationPolicyJson Json             @map("generation_policy_json")
  evaluationPolicyJson Json             @map("evaluation_policy_json")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz
  grammarPoint         GrammarPoint     @relation(fields: [grammarPointId], references: [id], onDelete: Restrict)
  rules                GrammarRule[]
  examples             GrammarExample[]
  errorPatterns        ErrorPattern[]
  exerciseTargets      ExerciseTarget[]
  curriculumItems      CurriculumItem[]

  @@unique([grammarPointId, versionNo, locale])
  @@index([status, cefrLevel])
  @@map("grammar_point_versions")
}

model GrammarRelationship {
  id               String           @id @default(uuid()) @db.Uuid
  sourcePointId    String           @map("source_point_id") @db.Uuid
  targetPointId    String           @map("target_point_id") @db.Uuid
  relationshipType RelationshipType @map("relationship_type")
  rationale        String?
  strength         Decimal?         @db.Decimal(3, 2)
  status           ContentStatus    @default(DRAFT)
  sourcePoint      GrammarPoint     @relation("SourcePoint", fields: [sourcePointId], references: [id], onDelete: Restrict)
  targetPoint      GrammarPoint     @relation("TargetPoint", fields: [targetPointId], references: [id], onDelete: Restrict)

  @@unique([sourcePointId, targetPointId, relationshipType])
  @@index([targetPointId, relationshipType])
  @@map("grammar_relationships")
}

model GrammarRule {
  id                    String              @id @default(uuid()) @db.Uuid
  grammarPointVersionId String              @map("grammar_point_version_id") @db.Uuid
  ruleCode              String              @map("rule_code")
  ruleType              String              @map("rule_type")
  description           String
  patternJson           Json                @default("{}") @map("pattern_json")
  priority              Int                 @default(0)
  grammarPointVersion   GrammarPointVersion @relation(fields: [grammarPointVersionId], references: [id], onDelete: Restrict)

  @@unique([grammarPointVersionId, ruleCode])
  @@map("grammar_rules")
}

model GrammarExample {
  id                    String              @id @default(uuid()) @db.Uuid
  grammarPointVersionId String              @map("grammar_point_version_id") @db.Uuid
  exampleType           String              @map("example_type")
  englishText           String              @map("english_text")
  vietnameseText        String              @map("vietnamese_text")
  explanation           String
  tags                  String[]            @default([])
  sortOrder             Int                 @default(0) @map("sort_order")
  grammarPointVersion   GrammarPointVersion @relation(fields: [grammarPointVersionId], references: [id], onDelete: Restrict)

  @@index([grammarPointVersionId, sortOrder])
  @@map("grammar_examples")
}

model ErrorPattern {
  id                    String              @id @default(uuid()) @db.Uuid
  grammarPointVersionId String              @map("grammar_point_version_id") @db.Uuid
  errorCode             String              @map("error_code")
  incorrectPattern      String              @map("incorrect_pattern")
  correctedPattern      String              @map("corrected_pattern")
  explanationVi         String              @map("explanation_vi")
  detectionHintJson     Json                @default("{}") @map("detection_hint_json")
  severity              String
  grammarPointVersion   GrammarPointVersion @relation(fields: [grammarPointVersionId], references: [id], onDelete: Restrict)

  @@unique([grammarPointVersionId, errorCode])
  @@map("error_patterns")
}

model Curriculum {
  id           String              @id @default(uuid()) @db.Uuid
  code         String              @unique
  title        String
  audienceJson Json                @default("{}") @map("audience_json")
  status       ContentStatus       @default(DRAFT)
  releases     CurriculumRelease[]

  @@map("curricula")
}

model CurriculumRelease {
  id           String                     @id @default(uuid()) @db.Uuid
  curriculumId String                     @map("curriculum_id") @db.Uuid
  versionNo    Int                        @map("version_no")
  status       ContentStatus              @default(DRAFT)
  publishedAt  DateTime?                  @map("published_at") @db.Timestamptz
  contentHash  String                     @map("content_hash")
  curriculum   Curriculum                 @relation(fields: [curriculumId], references: [id], onDelete: Restrict)
  levels       CurriculumLevel[]
  enrollments  UserCurriculumEnrollment[]

  @@unique([curriculumId, versionNo])
  @@map("curriculum_releases")
}

model CurriculumLevel {
  id               String                     @id @default(uuid()) @db.Uuid
  releaseId        String                     @map("release_id") @db.Uuid
  code             String
  cefrLevel        CefrLevel                  @map("cefr_level")
  title            String
  sortOrder        Int                        @map("sort_order")
  unlockPolicyJson Json                       @default("{}") @map("unlock_policy_json")
  release          CurriculumRelease          @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  units            CurriculumUnit[]
  enrollments      UserCurriculumEnrollment[]
  progress         LevelProgress[]

  @@unique([releaseId, code])
  @@unique([releaseId, sortOrder])
  @@map("curriculum_levels")
}

model CurriculumUnit {
  id         String           @id @default(uuid()) @db.Uuid
  levelId    String           @map("level_id") @db.Uuid
  code       String
  title      String
  sortOrder  Int              @map("sort_order")
  level      CurriculumLevel  @relation(fields: [levelId], references: [id], onDelete: Restrict)
  items      CurriculumItem[]
  challenges UnitChallenge[]

  @@unique([levelId, code])
  @@unique([levelId, sortOrder])
  @@map("curriculum_units")
}

model CurriculumItem {
  id                    String              @id @default(uuid()) @db.Uuid
  unitId                String              @map("unit_id") @db.Uuid
  grammarPointVersionId String              @map("grammar_point_version_id") @db.Uuid
  role                  String
  sortOrder             Int                 @map("sort_order")
  weight                Decimal             @default(1) @db.Decimal(5, 2)
  minimumEvidenceCount  Int                 @default(3) @map("minimum_evidence_count")
  unit                  CurriculumUnit      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  grammarPointVersion   GrammarPointVersion @relation(fields: [grammarPointVersionId], references: [id], onDelete: Restrict)

  @@unique([unitId, grammarPointVersionId, role])
  @@unique([unitId, sortOrder])
  @@map("curriculum_items")
}

model UserCurriculumEnrollment {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  releaseId      String            @map("release_id") @db.Uuid
  currentLevelId String?           @map("current_level_id") @db.Uuid
  status         String            @default("ACTIVE")
  enrolledAt     DateTime          @default(now()) @map("enrolled_at") @db.Timestamptz
  completedAt    DateTime?         @map("completed_at") @db.Timestamptz
  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  release        CurriculumRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  currentLevel   CurriculumLevel?  @relation(fields: [currentLevelId], references: [id], onDelete: Restrict)
  sessions       LearningSession[]

  @@unique([userId, releaseId])
  @@map("user_curriculum_enrollments")
}

model LevelProgress {
  userId            String          @map("user_id") @db.Uuid
  curriculumLevelId String          @map("curriculum_level_id") @db.Uuid
  status            String          @default("LOCKED")
  progressScore     Decimal         @default(0) @map("progress_score") @db.Decimal(5, 2)
  unlockedAt        DateTime?       @map("unlocked_at") @db.Timestamptz
  completedAt       DateTime?       @map("completed_at") @db.Timestamptz
  policyVersion     String          @map("policy_version")
  user              User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  curriculumLevel   CurriculumLevel @relation(fields: [curriculumLevelId], references: [id], onDelete: Restrict)

  @@id([userId, curriculumLevelId])
  @@map("level_progress")
}

model LearningSession {
  id                       String                   @id @default(uuid()) @db.Uuid
  userId                   String                   @map("user_id") @db.Uuid
  enrollmentId             String                   @map("enrollment_id") @db.Uuid
  idempotencyKey           String                   @map("idempotency_key")
  requestHash              String                   @map("request_hash")
  completionIdempotencyKey String?                  @map("completion_idempotency_key")
  completionRequestHash    String?                  @map("completion_request_hash")
  sessionType              String                   @map("session_type")
  status                   String                   @default("ACTIVE")
  planPolicyVersion        String                   @map("plan_policy_version")
  startedAt                DateTime                 @default(now()) @map("started_at") @db.Timestamptz
  completedAt              DateTime?                @map("completed_at") @db.Timestamptz
  summaryJson              Json                     @default("{}") @map("summary_json")
  user                     User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  enrollment               UserCurriculumEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  items                    SessionItem[]
  unitChallenge            UnitChallenge?

  @@unique([userId, idempotencyKey])
  @@unique([userId, completionIdempotencyKey])
  @@index([userId, startedAt(sort: Desc)])
  @@map("learning_sessions")
}

model UnitChallenge {
  id            String                @id @default(uuid()) @db.Uuid
  userId        String                @map("user_id") @db.Uuid
  unitId        String                @map("unit_id") @db.Uuid
  sessionId     String                @unique @map("session_id") @db.Uuid
  status        String                @default("ACTIVE")
  policyVersion String                @map("policy_version")
  startedAt     DateTime              @default(now()) @map("started_at") @db.Timestamptz
  completedAt   DateTime?             @map("completed_at") @db.Timestamptz
  user          User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  unit          CurriculumUnit        @relation(fields: [unitId], references: [id], onDelete: Restrict)
  session       LearningSession       @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  targets       UnitChallengeTarget[]

  @@index([userId, startedAt(sort: Desc)])
  @@index([unitId])
  @@map("unit_challenges")
}

model UnitChallengeTarget {
  challengeId    String        @map("challenge_id") @db.Uuid
  grammarPointId String        @map("grammar_point_id") @db.Uuid
  grammarCode    String        @map("grammar_code")
  grammarTitle   String        @map("grammar_title")
  sortOrder      Int           @map("sort_order")
  challenge      UnitChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  grammarPoint   GrammarPoint  @relation(fields: [grammarPointId], references: [id], onDelete: Restrict)

  @@id([challengeId, grammarPointId])
  @@index([grammarPointId])
  @@map("unit_challenge_targets")
}

model Exercise {
  id                     String             @id @default(uuid()) @db.Uuid
  contentKey             String             @unique @map("content_key")
  origin                 String
  type                   String
  contentStatus          ContentStatus      @default(DRAFT) @map("content_status")
  generatorVersion       String             @map("generator_version")
  evaluatorRubricVersion String             @map("evaluator_rubric_version")
  locale                 String             @default("vi")
  difficulty             Int
  promptContextVi        String             @map("prompt_context_vi")
  instructionVi          String             @map("instruction_vi")
  semanticHash           String             @map("semantic_hash")
  topicCode              String             @default("DAILY_LIFE") @map("topic_code")
  constraintsJson        Json               @default("{}") @map("constraints_json")
  contentSnapshotJson    Json               @map("content_snapshot_json")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz
  targets                ExerciseTarget[]
  sentences              ExerciseSentence[]
  sessionItems           SessionItem[]
  attempts               Attempt[]
  vocabularyHints        VocabularyHint[]
  storyScenes            StoryScene[]

  @@index([semanticHash])
  @@index([type, topicCode])
  @@map("exercises")
}

model StorySeries {
  id          String              @id @default(uuid()) @db.Uuid
  code        String              @unique
  title       String
  description String
  cefrLevel   CefrLevel           @map("cefr_level")
  versionNo   Int                 @map("version_no")
  status      ContentStatus       @default(DRAFT)
  chapters    StoryChapter[]
  progress    UserStoryProgress[]

  @@index([status, cefrLevel])
  @@map("story_series")
}

model StoryChapter {
  id        String       @id @default(uuid()) @db.Uuid
  seriesId  String       @map("series_id") @db.Uuid
  code      String
  title     String
  sortOrder Int          @map("sort_order")
  series    StorySeries  @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  scenes    StoryScene[]

  @@unique([seriesId, code])
  @@unique([seriesId, sortOrder])
  @@map("story_chapters")
}

model StoryScene {
  id                 String                     @id @default(uuid()) @db.Uuid
  chapterId          String                     @map("chapter_id") @db.Uuid
  code               String
  title              String
  narrativeVi        String                     @map("narrative_vi")
  dialogueJson       Json                       @default("[]") @map("dialogue_json")
  exerciseId         String?                    @map("exercise_id") @db.Uuid
  defaultNextSceneId String?                    @map("default_next_scene_id") @db.Uuid
  memoryFactsJson    Json                       @default("[]") @map("memory_facts_json")
  sortOrder          Int                        @map("sort_order")
  chapter            StoryChapter               @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  exercise           Exercise?                  @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  defaultNextScene   StoryScene?                @relation("DefaultScenePath", fields: [defaultNextSceneId], references: [id], onDelete: Restrict)
  previousScenes     StoryScene[]               @relation("DefaultScenePath")
  choices            StoryChoice[]              @relation("SceneChoices")
  incomingChoices    StoryChoice[]              @relation("ChoiceDestination")
  currentProgress    UserStoryProgress[]        @relation("CurrentStoryScene")
  userChoices        UserStoryChoice[]
  completions        UserStorySceneCompletion[]

  @@unique([chapterId, code])
  @@unique([chapterId, sortOrder])
  @@index([exerciseId])
  @@index([defaultNextSceneId])
  @@map("story_scenes")
}

model StoryChoice {
  id              String            @id @default(uuid()) @db.Uuid
  sceneId         String            @map("scene_id") @db.Uuid
  nextSceneId     String            @map("next_scene_id") @db.Uuid
  code            String
  labelVi         String            @map("label_vi")
  memoryFactsJson Json              @default("[]") @map("memory_facts_json")
  sortOrder       Int               @map("sort_order")
  scene           StoryScene        @relation("SceneChoices", fields: [sceneId], references: [id], onDelete: Restrict)
  nextScene       StoryScene        @relation("ChoiceDestination", fields: [nextSceneId], references: [id], onDelete: Restrict)
  userChoices     UserStoryChoice[]

  @@unique([sceneId, code])
  @@unique([sceneId, sortOrder])
  @@index([nextSceneId])
  @@map("story_choices")
}

model UserStoryProgress {
  id              String                     @id @default(uuid()) @db.Uuid
  userId          String                     @map("user_id") @db.Uuid
  seriesId        String                     @map("series_id") @db.Uuid
  currentSceneId  String?                    @map("current_scene_id") @db.Uuid
  status          String                     @default("ACTIVE")
  memoryFactsJson Json                       @default("[]") @map("memory_facts_json")
  version         Int                        @default(1)
  startedAt       DateTime                   @default(now()) @map("started_at") @db.Timestamptz
  completedAt     DateTime?                  @map("completed_at") @db.Timestamptz
  updatedAt       DateTime                   @updatedAt @map("updated_at") @db.Timestamptz
  user            User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  series          StorySeries                @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  currentScene    StoryScene?                @relation("CurrentStoryScene", fields: [currentSceneId], references: [id], onDelete: Restrict)
  choices         UserStoryChoice[]
  completions     UserStorySceneCompletion[]

  @@unique([userId, seriesId])
  @@index([currentSceneId])
  @@map("user_story_progress")
}

model UserStoryChoice {
  id             String            @id @default(uuid()) @db.Uuid
  progressId     String            @map("progress_id") @db.Uuid
