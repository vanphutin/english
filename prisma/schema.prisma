model Attempt {
  id                       String                @id @default(uuid()) @db.Uuid
  exerciseId               String                @map("exercise_id") @db.Uuid
  sessionItemId            String                @map("session_item_id") @db.Uuid
  userId                   String                @map("user_id") @db.Uuid
  attemptNo                Int                   @map("attempt_no")
  answerText               String                @map("answer_text")
  normalizedAnswer         String                @map("normalized_answer")
  status                   AttemptStatus         @default(SUBMITTED)
  idempotencyKey           String                @map("idempotency_key")
  requestHash              String                @map("request_hash")
  submittedAt              DateTime              @default(now()) @map("submitted_at") @db.Timestamptz
  evaluatedAt              DateTime?             @map("evaluated_at") @db.Timestamptz
