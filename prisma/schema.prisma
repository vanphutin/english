enum ContentFactoryJobPurpose {
  PLAN_MANIFEST
  AUTHOR_GRAMMAR
  AUTHOR_EXERCISES
  VALIDATE
  REVIEW
  BUILD_FIXTURES
  PUBLISH
}

enum ContentFactoryJobState {
  QUEUED
  CLAIMED
  GENERATING
  GENERATED
  VALIDATING
  IN_REVIEW
  READY_FOR_APPROVAL
  APPROVED
  PUBLISHING
  SUCCEEDED
  CHANGES_REQUESTED
  RETRY_WAIT
  QUARANTINED
  REJECTED
  CANCELLED
  FAILED
}

model ContentFactoryRun {
  id               String                   @id @default(uuid()) @db.Uuid
  policyVersion    String                   @default("content-factory-v1") @map("policy_version")
  status           String                   @default("DRAFT ONLY")
  manifestCode     String?                  @map("manifest_code")
  manifestHash     String?                  @map("manifest_hash")
  maxRequests      Int                      @default(100) @map("max_requests")
  maxInputTokens   Int                      @default(500000) @map("max_input_tokens")
  maxOutputTokens  Int                      @default(200000) @map("max_output_tokens")
  maxEstimatedCost Float                    @default(10.0) @map("max_estimated_cost")
  usedRequests     Int                      @default(0) @map("used_requests")
  usedInputTokens  Int                      @default(0) @map("used_input_tokens")
  usedOutputTokens Int                      @default(0) @map("used_output_tokens")
  usedCost         Float                    @default(0.0) @map("used_cost")
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz
  jobs             ContentFactoryJob[]
  artifacts        ContentFactoryArtifact[]
  approvals        ContentFactoryApproval[]
  validations      ContentValidationRun[]
  reviews          ContentReviewRun[]
  publications     ContentPublication[]

  @@map("content_factory_runs")
}

model ContentFactoryJob {
  id                  String                   @id @default(uuid()) @db.Uuid
  runId               String                   @map("run_id") @db.Uuid
  purpose             ContentFactoryJobPurpose
  targetCode          String                   @map("target_code")
  targetVersion       Int                      @default(1) @map("target_version")
  state               ContentFactoryJobState   @default(QUEUED)
  attempt             Int                      @default(1)
  idempotencyKey      String                   @unique @map("idempotency_key")
  inputHash           String                   @map("input_hash")
  outputHash          String?                  @map("output_hash")
  policyVersionsJson  Json                     @map("policy_versions_json")
  budgetJson          Json                     @map("budget_json")
  workerId            String?                  @map("worker_id")
  leaseExpiresAt      DateTime?                @map("lease_expires_at") @db.Timestamptz
  normalizedErrorCode String?                  @map("normalized_error_code")
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz
  run                 ContentFactoryRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  artifacts           ContentFactoryArtifact[]
  validations         ContentValidationRun[]
  reviews             ContentReviewRun[]

  @@index([runId, state])
  @@index([state, leaseExpiresAt])
  @@map("content_factory_jobs")
}

model ContentFactoryArtifact {
  id           String             @id @default(uuid()) @db.Uuid
  runId        String             @map("run_id") @db.Uuid
  jobId        String?            @map("job_id") @db.Uuid
  artifactPath String             @map("artifact_path")
  artifactType String             @map("artifact_type")
  contentHash  String             @map("content_hash")
  storageUri   String             @map("storage_uri")
  metadataJson Json               @default("{}") @map("metadata_json")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz
  run          ContentFactoryRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  job          ContentFactoryJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([runId, artifactType])
  @@index([contentHash])
  @@map("content_factory_artifacts")
}

model ContentFactoryApproval {
  id             String               @id @default(uuid()) @db.Uuid
  runId          String               @map("run_id") @db.Uuid
  approvedBy     String               @map("approved_by")
  scopeHash      String               @map("scope_hash")
  approvalHash   String               @map("approval_hash")
  rationale      String
  requestHash    String               @map("request_hash")
  decisionSource String               @default("OWNER_CLI") @map("decision_source")
  approvedAt     DateTime             @default(now()) @map("approved_at") @db.Timestamptz
  run            ContentFactoryRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  publications   ContentPublication[]

  @@unique([runId, scopeHash])
  @@index([runId, approvedAt(sort: Desc)])
  @@map("content_factory_approvals")
}

model ContentValidationRun {
  id               String            @id @default(uuid()) @db.Uuid
  runId            String            @map("run_id") @db.Uuid
  jobId            String            @map("job_id") @db.Uuid
  artifactHash     String            @map("artifact_hash")
  validatorVersion String            @map("validator_version")
  passed           Boolean
  reportJson       Json              @map("report_json")
  reportHash       String            @map("report_hash")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  run              ContentFactoryRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  job              ContentFactoryJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, artifactHash, validatorVersion])
  @@index([runId, createdAt(sort: Desc)])
  @@map("content_validation_runs")
}

model ContentReviewRun {
  id               String            @id @default(uuid()) @db.Uuid
  runId            String            @map("run_id") @db.Uuid
  jobId            String            @map("job_id") @db.Uuid
  artifactHash     String            @map("artifact_hash")
  reviewerProvider String            @map("reviewer_provider")
  reviewerModel    String            @map("reviewer_model")
  promptVersion    String            @map("prompt_version")
  decision         String
  qualityScore     Decimal           @map("quality_score") @db.Decimal(5, 2)
  reportJson       Json              @map("report_json")
  reportHash       String            @map("report_hash")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  run              ContentFactoryRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  job              ContentFactoryJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, artifactHash, promptVersion])
  @@index([runId, decision, createdAt(sort: Desc)])
  @@map("content_review_runs")
}

model ContentPublication {
  id          String                 @id @default(uuid()) @db.Uuid
  runId       String                 @map("run_id") @db.Uuid
  approvalId  String                 @map("approval_id") @db.Uuid
  batchHash   String                 @unique @map("batch_hash")
  status      String
  releaseId   String?                @map("release_id") @db.Uuid
  resultJson  Json                   @map("result_json")
  publishedAt DateTime?              @map("published_at") @db.Timestamptz
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz
  run         ContentFactoryRun      @relation(fields: [runId], references: [id], onDelete: Restrict)
  approval    ContentFactoryApproval @relation(fields: [approvalId], references: [id], onDelete: Restrict)

  @@index([runId, createdAt(sort: Desc)])
  @@index([approvalId])
  @@map("content_publications")
}
